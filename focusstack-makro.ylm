          import android.hardware.camera2.CameraCaptureSession
          import android.hardware.camera2.CameraCharacteristics
          import android.hardware.camera2.CameraDevice
          import android.hardware.camera2.CameraManager
          import android.hardware.camera2.CaptureRequest
          import android.hardware.camera2.CaptureResult
          import android.hardware.camera2.TotalCaptureResult
          import android.hardware.camera2.params.OutputConfiguration
          import android.hardware.camera2.params.SessionConfiguration
          import android.media.ImageReader
          import android.os.Bundle
          import android.os.Handler
          import android.os.HandlerThread
          import android.provider.MediaStore
          import android.util.Size
          import android.view.Gravity
          import android.view.Surface
          import android.view.TextureView
          import android.view.ViewGroup
          import android.view.WindowManager
          import android.widget.Button
          import android.widget.FrameLayout
          import android.widget.LinearLayout
          import android.widget.ScrollView
          import android.widget.SeekBar
          import android.widget.TextView
          import android.widget.Toast
          import kotlinx.coroutines.CancellationException
          import kotlinx.coroutines.CompletableDeferred
          import kotlinx.coroutines.CoroutineScope
          import kotlinx.coroutines.Dispatchers
          import kotlinx.coroutines.Job
          import kotlinx.coroutines.SupervisorJob
          import kotlinx.coroutines.cancel
          import kotlinx.coroutines.delay
          import kotlinx.coroutines.launch
          import kotlinx.coroutines.suspendCancellableCoroutine
          import kotlinx.coroutines.withContext
          import kotlinx.coroutines.withTimeout
          import kotlinx.coroutines.withTimeoutOrNull
          import java.io.File
          import java.text.SimpleDateFormat
          import java.util.Date
          import java.util.Locale
          import kotlin.coroutines.resume
          import kotlin.coroutines.resumeWithException
          import kotlin.math.hypot
          import kotlin.math.pow
          import kotlin.math.roundToInt

          class MainActivity : Activity() {

              companion object {
                  const val FAR_DIOPTER = 0.12f
                  // An exponent above 1 makes the first steps smaller in lens coordinates.
                  const val GAMMA = 1.5f
                  const val SETTLE_MS = 160L
                  const val OUT_DIR = "Pictures/S23Ultra_FocusStack"
              }

              private class Lens(
                  val label: String,
                  val openId: String,
                  val physicalId: String?,
                  val chars: CameraCharacteristics,
                  val minFocus: Float
              )

              private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Main)
              private lateinit var cm: CameraManager
              private lateinit var textureView: TextureView
              private lateinit var statusView: TextView
              private lateinit var countView: TextView
              private lateinit var btn06: Button
              private lateinit var btn1: Button
              private lateinit var shutter: Button
              private lateinit var bgThread: HandlerThread
              private lateinit var bg: Handler

              private val lenses = LinkedHashMap<String, Lens>()
              private var selected = "0.6x"
              private var frameCount = 16

              private var camera: CameraDevice? = null
              private var session: CameraCaptureSession? = null
              private var sessionLens: CameraCharacteristics? = null
              private var sessionPhysicalId: String? = null
              private var physicalRequestKeys: List<CaptureRequest.Key<*>> = emptyList()
              private var reader: ImageReader? = null
              private var previewSurface: Surface? = null
              private var camJob: Job? = null
              private var busy = false

              @Volatile private var lastResult: TotalCaptureResult? = null
              @Volatile private var pending: CompletableDeferred<File>? = null

              override fun onCreate(savedInstanceState: Bundle?) {
                  super.onCreate(savedInstanceState)

                  val crashFile = File(filesDir, "crash.txt")
                  val prevHandler = Thread.getDefaultUncaughtExceptionHandler()
                  Thread.setDefaultUncaughtExceptionHandler { t, e ->
                      try { crashFile.writeText(android.util.Log.getStackTraceString(e)) } catch (_: Throwable) {}
                      prevHandler?.uncaughtException(t, e)
                  }
                  if (crashFile.exists()) {
                      val report = crashFile.readText()
                      crashFile.delete()
                      val tv = TextView(this).apply {
                          text = "COKME RAPORU:\n\n$report"
                          setTextColor(Color.WHITE)
                          textSize = 11f
                          setTextIsSelectable(true)
                          setPadding(dp(12), dp(12), dp(12), dp(12))
                      }
                      val btn = Button(this).apply { text = "Uygulamayi Baslat"; setOnClickListener { recreate() } }
                      val box = LinearLayout(this).apply {
                          orientation = LinearLayout.VERTICAL
                          setBackgroundColor(Color.BLACK)
                          addView(btn)
                          addView(ScrollView(this@MainActivity).apply { addView(tv) })
                      }
                      setContentView(box)
                      return
                  }

                  window.addFlags(WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON)
                  cm = getSystemService(CAMERA_SERVICE) as CameraManager
                  bgThread = HandlerThread("cam-bg").also { it.start() }
                  bg = Handler(bgThread.looper)
                  buildUi()
                  discoverLenses()
                  updateLensUi()
              }

              override fun onResume() {
                  super.onResume()
                  if (checkSelfPermission(Manifest.permission.CAMERA) == PackageManager.PERMISSION_GRANTED) {
                      if (textureView.isAvailable) startCamera()
                  } else {
                      requestPermissions(arrayOf(Manifest.permission.CAMERA), 101)
                  }
              }

              override fun onPause() {
                  camJob?.cancel()
                  closeCamera()
                  super.onPause()
              }

              override fun onDestroy() {
                  scope.cancel()
                  bgThread.quitSafely()
                  super.onDestroy()
              }

              override fun onRequestPermissionsResult(
                  requestCode: Int, permissions: Array<out String>, grantResults: IntArray
              ) {
                  super.onRequestPermissionsResult(requestCode, permissions, grantResults)
                  if (grantResults.isNotEmpty() && grantResults[0] == PackageManager.PERMISSION_GRANTED) {
                      discoverLenses()
                      updateLensUi()
                      if (textureView.isAvailable) startCamera()
                  } else {
                      status("Kamera izni reddedildi.")
                  }
              }

              private fun dp(v: Int) = (v * resources.displayMetrics.density).toInt()

              private fun buildUi() {
                  val sw = resources.displayMetrics.widthPixels
                  val root = FrameLayout(this).apply { setBackgroundColor(Color.BLACK) }

                  textureView = TextureView(this)
                  root.addView(
                      textureView,
                      FrameLayout.LayoutParams(sw, sw * 4 / 3, Gravity.TOP or Gravity.CENTER_HORIZONTAL)
                  )
                  textureView.surfaceTextureListener = object : TextureView.SurfaceTextureListener {
                      override fun onSurfaceTextureAvailable(st: SurfaceTexture, w: Int, h: Int) = startCamera()
                      override fun onSurfaceTextureSizeChanged(st: SurfaceTexture, w: Int, h: Int) {}
                      override fun onSurfaceTextureDestroyed(st: SurfaceTexture): Boolean = true
                      override fun onSurfaceTextureUpdated(st: SurfaceTexture) {}
                  }

                  statusView = TextView(this).apply {
                      setTextColor(Color.WHITE)
                      textSize = 13f
                      setPadding(dp(12), dp(10), dp(12), dp(10))
                      setBackgroundColor(0x88000000.toInt())
                  }
                  root.addView(
                      statusView,
                      FrameLayout.LayoutParams(
                          ViewGroup.LayoutParams.MATCH_PARENT,
                          ViewGroup.LayoutParams.WRAP_CONTENT,
                          Gravity.TOP
                      )
                  )

                  val panel = LinearLayout(this).apply {
                      orientation = LinearLayout.VERTICAL
                      setPadding(dp(16), dp(10), dp(16), dp(22))
                      setBackgroundColor(0xCC000000.toInt())
                  }

                  countView = TextView(this).apply {
                      setTextColor(Color.WHITE)
                      textSize = 14f
                      text = "Odak Basamak Sayisi: $frameCount kare"
                  }
                  val seekCount = SeekBar(this).apply {
                      max = 25 // 5..30
                      progress = frameCount - 5
                      setOnSeekBarChangeListener(object : SeekBar.OnSeekBarChangeListener {
                          override fun onProgressChanged(sb: SeekBar?, p: Int, fromUser: Boolean) {
                              frameCount = p + 5
                              countView.text = "Odak Basamak Sayisi: $frameCount kare"
                          }
                          override fun onStartTrackingTouch(sb: SeekBar?) {}
                          override fun onStopTrackingTouch(sb: SeekBar?) {}
                      })
                  }

                  btn06 = Button(this).apply { text = "0.6x (Makro)"; setOnClickListener { selectLens("0.6x") } }
                  btn1 = Button(this).apply { text = "1x (Ana)"; setOnClickListener { selectLens("1x") } }
                  shutter = Button(this).apply { text = "BASLAT"; setOnClickListener { onShutter() } }

                  val row = LinearLayout(this).apply {
                      orientation = LinearLayout.HORIZONTAL
                      gravity = Gravity.CENTER
                      setPadding(0, dp(6), 0, 0)
                  }
                  row.addView(btn06, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
                  row.addView(shutter, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1.3f))
                  row.addView(btn1, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))

                  panel.addView(countView)
                  panel.addView(seekCount)
                  panel.addView(row)
                  root.addView(
                      panel,
                      FrameLayout.LayoutParams(
                          ViewGroup.LayoutParams.MATCH_PARENT,
                          ViewGroup.LayoutParams.WRAP_CONTENT,
                          Gravity.BOTTOM
                      )
                  )
                  setContentView(root)
              }

              private fun status(msg: String) {
                  runOnUiThread { statusView.text = msg }
              }

              private fun toast(msg: String) {
                  runOnUiThread { Toast.makeText(this, msg, Toast.LENGTH_LONG).show() }
              }

              private fun updateLensUi() {
                  btn06.isEnabled = lenses.containsKey("0.6x")
                  btn1.isEnabled = lenses.containsKey("1x")
                  btn06.alpha = if (selected == "0.6x") 1f else 0.5f
                  btn1.alpha = if (selected == "1x") 1f else 0.5f

              }

              private fun selectLens(key: String) {
                  if (busy || !lenses.containsKey(key)) return
                  selected = key
                  updateLensUi()
                  startCamera()
              }

              private fun discoverLenses() {
                  val candidates = ArrayList<Lens>()

                  fun inspect(openId: String, physId: String?, ch: CameraCharacteristics) {
                      if (ch.get(CameraCharacteristics.LENS_FACING) != CameraCharacteristics.LENS_FACING_BACK) return
                      val f = ch.get(CameraCharacteristics.LENS_INFO_AVAILABLE_FOCAL_LENGTHS)?.firstOrNull() ?: return
                      val minF = ch.get(CameraCharacteristics.LENS_INFO_MINIMUM_FOCUS_DISTANCE) ?: 0f
                      val sz = ch.get(CameraCharacteristics.SENSOR_INFO_PHYSICAL_SIZE)
                      val eq = if (sz != null && sz.width > 0f && sz.height > 0f) {
                          f * 43.27f / hypot(sz.width, sz.height)
                      } else {
                          if (f < 3.5f) 13f else 24f
                      }
                      val label = when {
                          eq < 18.5f || f < 3.2f || (openId == "2" && physId == null) -> "0.6x"
                          eq in 18.5f..35f || openId == "0" -> "1x"
                          else -> return
                      }
                      candidates.add(Lens(label, openId, physId, ch, minF))
                  }

                  val allIds = LinkedHashSet<String>()
                  try { allIds.addAll(cm.cameraIdList.toList()) } catch (_: Exception) {}
                  for (extra in listOf("0", "2")) allIds.add(extra)

                  for (id in allIds) {
                      val ch = try { cm.getCameraCharacteristics(id) } catch (_: Exception) { continue }
                      if (ch.get(CameraCharacteristics.LENS_FACING) != CameraCharacteristics.LENS_FACING_BACK) continue
                      inspect(id, null, ch)
                      val phys = try { ch.physicalCameraIds } catch (_: Exception) { emptySet<String>() }
                      for (p in phys) {
                          try { inspect(id, p, cm.getCameraCharacteristics(p)) } catch (_: Exception) {}
                      }
                  }

                  lenses.clear()
                  for (key in listOf("1x", "0.6x")) {
                      val best = candidates.filter { it.label == key }
                          .sortedWith(
                              compareByDescending<Lens> { it.minFocus > 0f }
                                  .thenByDescending { it.physicalId == null }
                                  .thenByDescending { it.minFocus }
                          ).firstOrNull()
                      if (best != null) lenses[key] = best
                  }

                  if (lenses[selected]?.minFocus?.let { it > 0f } != true) {
                      selected = lenses.values.firstOrNull { it.minFocus > 0f }?.label
                          ?: lenses.keys.firstOrNull() ?: selected
                  }
              }

              private fun closeCamera() {
                  try { session?.close() } catch (_: Exception) {}
                  try { camera?.close() } catch (_: Exception) {}
                  try { reader?.close() } catch (_: Exception) {}
                  try { previewSurface?.release() } catch (_: Exception) {}
                  session = null; camera = null; reader = null; previewSurface = null
                  sessionLens = null
                  sessionPhysicalId = null
                  physicalRequestKeys = emptyList()
                  lastResult = null
              }

              private fun startCamera() {
                  if (checkSelfPermission(Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) return
                  if (!textureView.isAvailable) return
                  camJob?.cancel()
                  camJob = scope.launch {
                      try {
                          closeCamera()
                          val lens = lenses[selected]
                          if (lens == null) {
                              status("Kamera lensi bulunamadi.")
                              return@launch
                          }
                          val map = lens.chars.get(CameraCharacteristics.SCALER_STREAM_CONFIGURATION_MAP)
                              ?: throw IllegalStateException("Stream haritasi alinamadi")

                          val prevSizes = map.getOutputSizes(SurfaceTexture::class.java) ?: arrayOf(Size(1280, 960))
                          val prev = prevSizes
                              .filter { it.width * 3 == it.height * 4 && it.width <= 1920 }
                              .maxByOrNull { it.width * it.height }
                              ?: prevSizes.firstOrNull() ?: Size(1280, 960)

                          val jpgAll = map.getOutputSizes(ImageFormat.JPEG) ?: arrayOf(Size(4000, 3000))
                          val jpg = jpgAll
                              .filter { it.width * 3 == it.height * 4 && it.width * it.height in 8_000_000..13_000_000 }
                              .maxByOrNull { it.width * it.height }
                              ?: jpgAll.maxByOrNull { it.width * it.height }!!

                          val dev = openDevice(lens.openId)
                          camera = dev
                          val rd = ImageReader.newInstance(jpg.width, jpg.height, ImageFormat.JPEG, 5)
                          rd.setOnImageAvailableListener(imageListener, bg)
                          reader = rd

                          val st = textureView.surfaceTexture!!
                          st.setDefaultBufferSize(prev.width, prev.height)
                          val ps = Surface(st)
                          previewSurface = ps

                          val (openedSession, physicalId) =
                              createSessionWithFallback(dev, listOf(ps, rd.surface), lens.physicalId)
                          val logical = cm.getCameraCharacteristics(lens.openId)
                          val effective = if (physicalId == null) logical else lens.chars
                          session = openedSession
                          sessionLens = effective
                          sessionPhysicalId = physicalId
                          physicalRequestKeys = if (physicalId == null) emptyList()
                              else logical.availablePhysicalCameraRequestKeys ?: emptyList()
                          openedSession.setRepeatingRequest(previewBuilder().build(), repeatCb, bg)

                          val maxFocus = effective.get(CameraCharacteristics.LENS_INFO_MINIMUM_FOCUS_DISTANCE) ?: 0f
                          val calibration = effective.get(CameraCharacteristics.LENS_INFO_FOCUS_DISTANCE_CALIBRATION)
                          val cmDist = if (maxFocus > 0f &&
                              (calibration == CameraCharacteristics.LENS_INFO_FOCUS_DISTANCE_CALIBRATION_APPROXIMATE ||
                                  calibration == CameraCharacteristics.LENS_INFO_FOCUS_DISTANCE_CALIBRATION_CALIBRATED)
                          ) " (~${(100f / maxFocus).roundToInt()} cm)" else ""
                          val cameraLabel = if (lens.physicalId != null && physicalId == null)
                              "Mantiksal kamera" else lens.label
                          status("$cameraLabel (ID:${lens.openId}${physicalId?.let { "/$it" } ?: ""}) • " +
                              "En yakin odak$cmDist • Telefonu sabit tutun")

                      } catch (e: CancellationException) {
                          throw e
                      } catch (e: Exception) {
                          status("Kamera acilamadi: ${e.message}")
                      }
                  }
              }

              @SuppressLint("MissingPermission")
              private suspend fun openDevice(id: String): CameraDevice = suspendCancellableCoroutine { c ->
                  cm.openCamera(id, mainExecutor, object : CameraDevice.StateCallback() {
                      override fun onOpened(d: CameraDevice) {
                          if (c.isActive) c.resume(d) else d.close()
                      }
                      override fun onDisconnected(d: CameraDevice) {
                          d.close()
                          if (c.isActive) c.resumeWithException(IllegalStateException("Kamera baglantisi kesildi"))
                      }
                      override fun onError(d: CameraDevice, error: Int) {
                          d.close()
                          if (c.isActive) c.resumeWithException(IllegalStateException("Kamera cihaz hatasi: $error"))
                      }
                  })
              }

              private suspend fun createSessionWithFallback(
                  dev: CameraDevice,
                  surfaces: List<Surface>,
                  physicalId: String?
              ): Pair<CameraCaptureSession, String?> {
                  if (physicalId != null) {
                      try {
                          return createSession(dev, surfaces, physicalId) to physicalId
                      } catch (e: CancellationException) {
                          throw e
                      } catch (_: Exception) {}
                  }
                  return createSession(dev, surfaces, null) to null
              }

              private suspend fun createSession(
                  dev: CameraDevice,
                  surfaces: List<Surface>,
                  physicalId: String?
              ): CameraCaptureSession = suspendCancellableCoroutine { c ->
                  val outs = surfaces.map { s ->
                      OutputConfiguration(s).also { oc ->
                          if (physicalId != null) oc.setPhysicalCameraId(physicalId)
                      }
                  }
                  val cfg = SessionConfiguration(
                      SessionConfiguration.SESSION_REGULAR, outs, mainExecutor,
                      object : CameraCaptureSession.StateCallback() {
                          override fun onConfigured(s: CameraCaptureSession) {
                              if (c.isActive) c.resume(s) else s.close()
                          }
                          override fun onConfigureFailed(s: CameraCaptureSession) {
                              if (c.isActive) c.resumeWithException(IllegalStateException("Kamera oturumu basarisiz"))
                          }
                      }
                  )
                  dev.createCaptureSession(cfg)
              }

              private fun requestBuilder(dev: CameraDevice, template: Int): CaptureRequest.Builder {
                  val id = sessionPhysicalId
                  return if (id != null && physicalRequestKeys.isNotEmpty())
                      dev.createCaptureRequest(template, setOf(id))
                  else dev.createCaptureRequest(template)
              }

              private fun previewBuilder(): CaptureRequest.Builder {
                  val b = requestBuilder(camera!!, CameraDevice.TEMPLATE_PREVIEW)
                  b.addTarget(previewSurface!!)
                  b.set(CaptureRequest.CONTROL_AF_MODE, CaptureRequest.CONTROL_AF_MODE_CONTINUOUS_PICTURE)
                  return b
              }

              private val repeatCb = object : CameraCaptureSession.CaptureCallback() {
                  override fun onCaptureCompleted(
                      s: CameraCaptureSession, r: CaptureRequest, result: TotalCaptureResult
                  ) {
                      lastResult = result
                  }
              }

              private val imageListener = ImageReader.OnImageAvailableListener { r ->
                  val img = r.acquireNextImage() ?: return@OnImageAvailableListener
                  try {
                      val target = pending ?: return@OnImageAvailableListener
                      val buf = img.planes[0].buffer
                      val bytes = ByteArray(buf.remaining())
                      buf.get(bytes)
                      val f = File(cacheDir, "fs_${System.nanoTime()}.jpg")
                      f.writeBytes(bytes)
                      if (pending !== target || !target.complete(f)) f.delete()
                  } catch (e: Exception) {
                      pending?.completeExceptionally(e)
                  } finally {
                      img.close()
                  }
              }

              private fun applyBurst(b: CaptureRequest.Builder, diopter: Float) {
                  b.set(CaptureRequest.CONTROL_AF_MODE, CaptureRequest.CONTROL_AF_MODE_OFF)
                  b.set(CaptureRequest.LENS_FOCUS_DISTANCE, diopter)
                  sessionPhysicalId?.let { id ->
                      if (CaptureRequest.CONTROL_AF_MODE in physicalRequestKeys) {
                          b.setPhysicalCameraKey(CaptureRequest.CONTROL_AF_MODE, CaptureRequest.CONTROL_AF_MODE_OFF, id)
                      }
                      if (CaptureRequest.LENS_FOCUS_DISTANCE in physicalRequestKeys) {
                          b.setPhysicalCameraKey(CaptureRequest.LENS_FOCUS_DISTANCE, diopter, id)
                      }
                  }
                  b.set(CaptureRequest.CONTROL_AE_LOCK, true)
                  b.set(CaptureRequest.CONTROL_AWB_LOCK, true)
                  b.set(
                      CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE,
                      CaptureRequest.LENS_OPTICAL_STABILIZATION_MODE_OFF
                  )
                  b.set(
                      CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE,
                      CaptureRequest.CONTROL_VIDEO_STABILIZATION_MODE_OFF
                  )
                  b.set(CaptureRequest.EDGE_MODE, CaptureRequest.EDGE_MODE_FAST)
                  b.set(CaptureRequest.NOISE_REDUCTION_MODE, CaptureRequest.NOISE_REDUCTION_MODE_FAST)
              }

              private fun focusSteps(n: Int, maxNear: Float): FloatArray {
                  val far = minOf(FAR_DIOPTER, maxNear)
                  return FloatArray(n) { i ->
                      when (i) {
                          0 -> maxNear
                          n - 1 -> far
                          else -> maxNear - (maxNear - far) * (i / (n - 1f)).pow(GAMMA)
                      }
                  }
              }

              private fun focusMetadata(result: TotalCaptureResult): CaptureResult =
                  sessionPhysicalId?.let { result.physicalCameraResults[it] } ?: result

              private suspend fun waitForFocus(tag: Any, desired: Float) {
                  delay(SETTLE_MS)
                  val tolerance = maxOf(0.08f, desired * 0.04f)
                  var stable: CaptureResult? = null
                  val matched = withTimeoutOrNull(1_400L) {
                      while (true) {
                          val frame = lastResult
                          if (frame != null && frame.request.tag === tag) {
                              val info = focusMetadata(frame)
                              if (info.get(CaptureResult.LENS_STATE) != CaptureResult.LENS_STATE_MOVING) {
                                  stable = info
                                  val measured = info.get(CaptureResult.LENS_FOCUS_DISTANCE)
                                  if (measured == null || kotlin.math.abs(measured - desired) <= tolerance) break
                              } else {
                                  stable = null
                              }
                          }
                          delay(25)
                      }
                      true
                  }
                  if (matched == null) {
                      val info = stable ?: throw IllegalStateException("Lens odagi zamaninda durmadi")
                      android.util.Log.w("FocusStack", "Odak istegi=$desired, durgun lens raporu=" +
                          info.get(CaptureResult.LENS_FOCUS_DISTANCE))
                  }
              }

              private fun onShutter() {
                  if (busy) return
                  val effective = sessionLens ?: return
                  val maxNear = effective.get(CameraCharacteristics.LENS_INFO_MINIMUM_FOCUS_DISTANCE) ?: 0f
                  if (maxNear <= 0f) {
                      toast("Bu lens manuel odak desteklemiyor (minFocus=0)")
                      return
                  }
                  busy = true
                  shutter.isEnabled = false
                  btn06.isEnabled = false
                  btn1.isEnabled = false

                  scope.launch {
                      val files = ArrayList<File>()
                      try {
                          runBurst(maxNear, files)
                          try { session?.setRepeatingRequest(previewBuilder().build(), repeatCb, bg) } catch (_: Exception) {}

                          val rotation = effective.get(CameraCharacteristics.SENSOR_ORIENTATION) ?: 90
                          val bmp = FocusStackProcessor.stack(files, rotation) { stage, d, t ->
                              status("$stage: $d / $t")
                          }
                          status("Galeriye kaydediliyor...")
                          val name = try { withContext(Dispatchers.IO) { saveToGallery(bmp) } }
                              finally { bmp.recycle() }
                          status("Tamamlandi: $OUT_DIR/$name")
                          toast("Kaydedildi: $OUT_DIR/$name")
                      } catch (e: CancellationException) {
                          throw e
                      } catch (e: Throwable) {
                          status("Hata: ${e.message}")
                          toast("Hata: ${e.message}")
                      } finally {
                          pending = null
                          try { session?.setRepeatingRequest(previewBuilder().build(), repeatCb, bg) } catch (_: Exception) {}
                          files.forEach { it.delete() }
                          busy = false
                          shutter.isEnabled = true
                          updateLensUi()
                      }
                  }
              }

              private suspend fun runBurst(maxNear: Float, files: MutableList<File>) {
                  val sess = session ?: throw IllegalStateException("Kamera oturumu hazir degil")
                  val dev = camera ?: throw IllegalStateException("Kamera cihazi hazir degil")
                  val rd = reader ?: throw IllegalStateException("ImageReader hazir degil")
                  val n = frameCount
                  val steps = focusSteps(n, maxNear)

                  status("Pozlama ve beyaz dengesi kilitleniyor...")
                  var waited = 0
                  while (waited < 2000) {
                      val st = lastResult?.get(CaptureResult.CONTROL_AE_STATE)
                      if (st == CaptureResult.CONTROL_AE_STATE_CONVERGED || st == CaptureResult.CONTROL_AE_STATE_LOCKED) break
                      delay(80); waited += 80
                  }

                  val lockB = previewBuilder()
                  applyBurst(lockB, steps[0])
                  sess.setRepeatingRequest(lockB.build(), repeatCb, bg)
                  delay(400)

                  for (i in 0 until n) {
                      status("Cekiliyor ${i + 1}/$n (Odak: ${"%.2f".format(steps[i])} dpt)")
                      val rb = previewBuilder()
                      applyBurst(rb, steps[i])
                      val focusTag = Any()
                      rb.setTag(focusTag)
                      sess.setRepeatingRequest(rb.build(), repeatCb, bg)
                      waitForFocus(focusTag, steps[i])

                      val cb = requestBuilder(dev, CameraDevice.TEMPLATE_STILL_CAPTURE)
                      cb.addTarget(rd.surface)
                      applyBurst(cb, steps[i])
                      cb.set(CaptureRequest.JPEG_QUALITY, 100.toByte())
                      cb.set(CaptureRequest.JPEG_ORIENTATION, 0)

                      val d = CompletableDeferred<File>()
                      pending = d
                      sess.capture(cb.build(), null, bg)
                      files.add(withTimeout(10_000) { d.await() })
                  }
                  pending = null
              }

              private fun saveToGallery(bmp: Bitmap): String {
                  val name = "S23U_Stack_" + SimpleDateFormat("yyyyMMdd_HHmmss", Locale.US).format(Date()) + ".jpg"
                  val values = ContentValues().apply {
                      put(MediaStore.Images.Media.DISPLAY_NAME, name)
                      put(MediaStore.Images.Media.MIME_TYPE, "image/jpeg")
                      put(MediaStore.Images.Media.RELATIVE_PATH, OUT_DIR)
                      put(MediaStore.Images.Media.IS_PENDING, 1)
                  }
                  val uri = contentResolver.insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, values)
                      ?: throw IllegalStateException("Galeri kaydi olusturulamadi")
                  contentResolver.openOutputStream(uri)!!.use { bmp.compress(Bitmap.CompressFormat.JPEG, 98, it) }
                  values.clear()
                  values.put(MediaStore.Images.Media.IS_PENDING, 0)
                  contentResolver.update(uri, values, null, null)
                  return name
              }
          }
          EOF

      - name: APK Derle
        run: gradle assembleDebug --stacktrace --no-daemon

      - name: APK Artifact Yukle
        uses: actions/upload-artifact@v4
        with:
          name: S23Ultra-FocusStack-APK
          path: app/build/outputs/apk/debug/app-debug.apk