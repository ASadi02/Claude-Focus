name: Build S23U FocusStack APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: JDK 17 Kurulumu
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Android SDK Lisanslarini Onayla
        run: yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses || true

      - name: Gradle 8.7 Kurulumu
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: '8.7'

      - name: Tum Proje ve Kotlin Kaynak Dosyalarini Olustur
        run: |
          rm -rf app build settings.gradle.kts build.gradle.kts gradle.properties
          mkdir -p app/src/main/java/com/s23ultra/focusstack
          echo "sdk.dir=$ANDROID_HOME" > local.properties

          cat > settings.gradle.kts << 'EOF'
          pluginManagement {
              repositories {
                  google()
                  mavenCentral()
                  gradlePluginPortal()
              }
          }
          dependencyResolutionManagement {
              repositoriesMode.set(RepositoriesMode.FAIL_ON_PROJECT_REPOS)
              repositories {
                  google()
                  mavenCentral()
              }
          }
          rootProject.name = "S23UltraFocusStack"
          include(":app")
          EOF

          cat > build.gradle.kts << 'EOF'
          plugins {
              id("com.android.application") version "8.3.2" apply false
              id("org.jetbrains.kotlin.android") version "1.9.23" apply false
          }
          EOF

          cat > gradle.properties << 'EOF'
          org.gradle.jvmargs=-Xmx4g -Dfile.encoding=UTF-8
          android.useAndroidX=true
          android.nonTransitiveRClass=true
          kotlin.code.style=official
          EOF

          cat > app/build.gradle.kts << 'EOF'
          plugins {
              id("com.android.application")
              id("org.jetbrains.kotlin.android")
          }

          android {
              namespace = "com.s23ultra.focusstack"
              compileSdk = 34

              defaultConfig {
                  applicationId = "com.s23ultra.focusstack"
                  minSdk = 29
                  targetSdk = 34
                  versionCode = 4
                  versionName = "3.1-S23U-Macro"
              }

              buildTypes {
                  release {
                      isMinifyEnabled = false
                  }
              }
              compileOptions {
                  sourceCompatibility = JavaVersion.VERSION_17
                  targetCompatibility = JavaVersion.VERSION_17
              }
              kotlinOptions {
                  jvmTarget = "17"
              }
          }

          dependencies {
              implementation("androidx.core:core-ktx:1.12.0")
              implementation("org.jetbrains.kotlinx:kotlinx-coroutines-android:1.7.3")
          }
          EOF

          cat > app/src/main/AndroidManifest.xml << 'EOF'
          <?xml version="1.0" encoding="utf-8"?>
          <manifest xmlns:android="http://schemas.android.com/apk/res/android">

              <uses-permission android:name="android.permission.CAMERA" />
              <uses-feature android:name="android.hardware.camera" android:required="true" />
              <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

              <application
                  android:allowBackup="false"
                  android:label="S23U Focus Stack"
                  android:largeHeap="true"
                  android:hardwareAccelerated="true"
                  android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
                  <activity
                      android:name="com.s23ultra.focusstack.MainActivity"
                      android:configChanges="orientation|screenSize|keyboardHidden"
                      android:exported="true"
                      android:screenOrientation="portrait">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                  </activity>
              </application>
          </manifest>
          EOF

          cat > app/src/main/java/com/s23ultra/focusstack/FocusStackProcessor.kt << 'EOF'
          package com.s23ultra.focusstack

          import android.graphics.Bitmap
          import android.graphics.BitmapFactory
          import android.graphics.Matrix
          import kotlinx.coroutines.Dispatchers
          import kotlinx.coroutines.ensureActive
          import kotlinx.coroutines.withContext
          import java.io.File
          import java.util.stream.IntStream
          import kotlin.math.abs
          import kotlin.math.max
          import kotlin.math.min
          import kotlin.coroutines.coroutineContext
          import kotlin.math.roundToInt

          object FocusStackProcessor {

              const val MAX_WORK_SIDE = 3072
              private const val EST_MAX_SIDE = 1280
              private const val FOCUS_STEP = 4
              private val GAUSS5 = floatArrayOf(1f / 16f, 4f / 16f, 6f / 16f, 4f / 16f, 1f / 16f)

              private class Img(val w: Int, val h: Int, val d: FloatArray)
              private class EstPyr(val levels: List<Img>)

              private inline fun parFor(n: Int, crossinline body: (Int) -> Unit) {
                  IntStream.range(0, n).parallel().forEach { i -> body(i) }
              }

              suspend fun stack(
                  files: List<File>,
                  rotationDeg: Int,
                  onProgress: (stage: String, done: Int, total: Int) -> Unit
              ): Bitmap = withContext(Dispatchers.Default) {
                  require(files.size >= 2) { "En az 2 kare gerekli" }
                  val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
                  BitmapFactory.decodeFile(files.first().path, bounds)
                  val srcW = bounds.outWidth
                  val srcH = bounds.outHeight
                  require(srcW >= 64 && srcH >= 64) { "Gecersiz JPEG boyutu" }
                  val workScale = min(1f, MAX_WORK_SIDE.toFloat() / max(srcW, srcH))
                  val w = max(64, (srcW * workScale).roundToInt())
                  val h = max(64, (srcH * workScale).roundToInt())
                  val estScale = min(1f, EST_MAX_SIDE.toFloat() / max(srcW, srcH))
                  val ew = max(64, (srcW * estScale).roundToInt())
                  val eh = max(64, (srcH * estScale).roundToInt())
                  val ref = files.size / 2
                  val transforms = align(files, ref, ew, eh, onProgress)
                  for (t in transforms) {
                      t[1] *= w.toDouble() / ew
                      t[2] *= h.toDouble() / eh
                  }

                  val pixels = IntArray(w * h)
                  val map = selectFocus(files, ref, transforms, w, h, pixels, onProgress)
                  val colors = compose(files, ref, transforms, w, h, map, pixels, onProgress)
                  val bmp = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888)
                  try {
                      bmp.setPixels(colors, 0, w, 0, 0, w, h)
                      if (rotationDeg % 360 == 0) bmp
                      else {
                          val matrix = Matrix().apply { postRotate(rotationDeg.toFloat()) }
                          val rotated = Bitmap.createBitmap(bmp, 0, 0, w, h, matrix, true)
                          if (rotated !== bmp) bmp.recycle()
                          rotated
                      }
                  } catch (e: Throwable) {
                      bmp.recycle()
                      throw e
                  }
              }

              private suspend fun align(
                  files: List<File>, ref: Int, w: Int, h: Int,
                  onProgress: (String, Int, Int) -> Unit
              ): Array<DoubleArray> {
                  val pixels = IntArray(w * h)
                  fun pyramid(i: Int): EstPyr {
                      decode(files[i], w, h, pixels)
                      val gray = FloatArray(pixels.size)
                      parFor(h) { y ->
                          for (x in 0 until w) {
                              val j = y * w + x
                              gray[j] = luma(pixels[j]).toFloat()
                          }
                      }
                      return buildEstPyr(gray, w, h)
                  }

                  val transforms = Array(files.size) { doubleArrayOf(1.0, 0.0, 0.0) }
                  val reference = pyramid(ref)
                  var done = 1
                  onProgress("Hizalama", done, files.size)
                  for (direction in intArrayOf(-1, 1)) {
                      var previous = reference
                      var i = ref + direction
                      while (i in files.indices) {
                          coroutineContext.ensureActive()
                          val current = pyramid(i)
                          val step = estimate(previous, current, w, h)
                          transforms[i] = composeTransform(transforms[i - direction], step)
                          previous = current
                          onProgress("Hizalama", ++done, files.size)
                          i += direction
                      }
                  }
                  return transforms
              }

              private fun luma(p: Int): Int =
                  (77 * ((p ushr 16) and 255) + 150 * ((p ushr 8) and 255) + 29 * (p and 255)) ushr 8

              private class FocusMap(val w: Int, val h: Int, val labels: IntArray)

              private suspend fun selectFocus(
                  files: List<File>, ref: Int, transforms: Array<DoubleArray>,
                  w: Int, h: Int, pixels: IntArray, onProgress: (String, Int, Int) -> Unit
              ): FocusMap {
                  val mw = (w + FOCUS_STEP - 1) / FOCUS_STEP
                  val mh = (h + FOCUS_STEP - 1) / FOCUS_STEP
                  val size = mw * mh
                  val best = FloatArray(size) { -1f }
                  val second = FloatArray(size) { -1f }
                  val winner = IntArray(size) { ref }
                  val guide = IntArray(size)
                  val gray = ByteArray(w * h)
                  val horizontal = ShortArray(w * h)
                  val scores = FloatArray(size)
                  val cx = (w - 1) * 0.5f
                  val cy = (h - 1) * 0.5f
                  // Prefer the reference where measurements tie exactly.
                  val order = listOf(ref) + files.indices.filter { it != ref }

                  for ((done, frame) in order.withIndex()) {
                      coroutineContext.ensureActive()
                      decode(files[frame], w, h, pixels)
                      measureFocus(pixels, w, h, gray, horizontal, scores, mw, mh)
                      val t = transforms[frame]
                      val s = t[0].toFloat()
                      val tx = t[1].toFloat()
                      val ty = t[2].toFloat()
                      parFor(mh) { y ->
                          val py = y * FOCUS_STEP
                          val qy = cy + (py - cy) * s + ty
                          if (qy < 0f || qy > h - 1f) return@parFor
                          val gy = (qy / FOCUS_STEP).coerceAtMost(mh - 1f)
                          val y0 = min(gy.toInt(), mh - 2)
                          for (x in 0 until mw) {
                              val px = x * FOCUS_STEP
                              val qx = cx + (px - cx) * s + tx
                              if (qx < 0f || qx > w - 1f) continue
                              val gx = (qx / FOCUS_STEP).coerceAtMost(mw - 1f)
                              val x0 = min(gx.toInt(), mw - 2)
                              val score = bilin(scores, y0 * mw + x0, mw, gx - x0, gy - y0)
                              val j = y * mw + x
                              if (frame == ref) guide[j] = gray[py * w + px].toInt() and 255
                              if (score > best[j]) {
                                  second[j] = best[j]
                                  best[j] = score
                                  winner[j] = frame
                              } else if (score > second[j]) {
                                  second[j] = score
                              }
                          }
                      }
                      onProgress("Net alanlar seciliyor", done + 1, files.size)
                  }

                  // Strong measurements define the map. Flat or ambiguous areas borrow a
                  // nearby reliable label of similar brightness; they never average the burst.
                  var labels = IntArray(size) { j ->
                      if (best[j] >= 2f && best[j] - second[j] >= max(0.35f, best[j] * 0.12f)) winner[j]
                      else -1
                  }
                  var next = IntArray(size)
                  for (radius in intArrayOf(1, 2, 4, 8)) {
                      coroutineContext.ensureActive()
                      parFor(mh) { y ->
                          for (x in 0 until mw) {
                              val j = y * mw + x
                              var label = labels[j]
                              if (label < 0) {
                                  var cost = 29
                                  for (dy in -1..1) for (dx in -1..1) {
                                      val ny = y + dy * radius
                                      val nx = x + dx * radius
                                      if (ny !in 0 until mh || nx !in 0 until mw) continue
                                      val k = ny * mw + nx
                                      val candidate = labels[k]
                                      if (candidate < 0) continue
                                      val delta = abs(guide[j] - guide[k]) + abs(dx) + abs(dy)
                                      if (delta < cost) {
                                          cost = delta
                                          label = candidate
                                      }
                                  }
                              }
                              next[j] = label
                          }
                      }
                      val swap = labels
                      labels = next
                      next = swap
                  }
                  for (j in labels.indices) {
                      if (labels[j] < 0) labels[j] = if (best[j] >= 1.25f) winner[j] else ref
                  }
                  return FocusMap(mw, mh, labels)
              }

              private fun measureFocus(
                  pixels: IntArray, w: Int, h: Int, gray: ByteArray, horizontal: ShortArray,
                  scores: FloatArray, mw: Int, mh: Int
              ) {
                  parFor(h) { y ->
                      val row = y * w
                      for (x in 0 until w) gray[row + x] = luma(pixels[row + x]).toByte()
                      for (x in 0 until w) {
                          val center = gray[row + x].toInt() and 255
                          val left = gray[row + max(0, x - 1)].toInt() and 255
                          val right = gray[row + min(w - 1, x + 1)].toInt() and 255
                          horizontal[row + x] = (left + 2 * center + right).toShort()
                      }
                  }
                  fun blurred(x: Int, y: Int): Int {
                      val c = x.coerceIn(0, w - 1)
                      val row = y.coerceIn(0, h - 1)
                      return horizontal[max(0, row - 1) * w + c].toInt() +
                          2 * horizontal[row * w + c].toInt() + horizontal[min(h - 1, row + 1) * w + c].toInt()
                  }
                  // Sample fine and coarser detail at working resolution before reducing
                  // to the focus map. A small neighborhood makes scores less noise-sensitive.
                  parFor(mh) { y ->
                      for (x in 0 until mw) {
                          var fine = 0
                          var coarse = 0
                          for (dy in -2..2 step 2) for (dx in -2..2 step 2) {
                              val px = (x * FOCUS_STEP + dx).coerceIn(0, w - 1)
                              val py = (y * FOCUS_STEP + dy).coerceIn(0, h - 1)
                              val center = 2 * blurred(px, py)
                              fine += abs(center - blurred(px - 1, py) - blurred(px + 1, py)) +
                                  abs(center - blurred(px, py - 1) - blurred(px, py + 1))
                              coarse += abs(center - blurred(px - 2, py) - blurred(px + 2, py)) +
                                  abs(center - blurred(px, py - 2) - blurred(px, py + 2))
                          }
                          scores[y * mw + x] = (fine + 0.25f * coarse) / (9 * 16f)
                      }
                  }
              }

              private suspend fun compose(
                  files: List<File>, ref: Int, transforms: Array<DoubleArray>, w: Int, h: Int,
                  map: FocusMap, pixels: IntArray, onProgress: (String, Int, Int) -> Unit
              ): IntArray {
                  val selected = map.labels.toSet().sorted()
                  val red = FloatArray(w * h)
                  val green = FloatArray(w * h)
                  val blue = FloatArray(w * h)
                  val weights = FloatArray(w * h)
                  val cx = (w - 1) * 0.5f
                  val cy = (h - 1) * 0.5f
                  for ((done, frame) in selected.withIndex()) {
                      coroutineContext.ensureActive()
                      decode(files[frame], w, h, pixels)
                      val t = transforms[frame]
                      val scale = t[0].toFloat()
                      val tx = t[1].toFloat()
                      val ty = t[2].toFloat()
                      parFor(map.h) { my ->
                          val top = my * FOCUS_STEP
                          val lowerRow = min(my + 1, map.h - 1) * map.w
                          for (mx in 0 until map.w) {
                              val left = mx * FOCUS_STEP
                              val right = min(mx + 1, map.w - 1)
                              val a = map.labels[my * map.w + mx] == frame
                              val b = map.labels[my * map.w + right] == frame
                              val c = map.labels[lowerRow + mx] == frame
                              val d = map.labels[lowerRow + right] == frame
                              if (!a && !b && !c && !d) continue
                              val solid = a && b && c && d
                              for (y in top until min(top + FOCUS_STEP, h)) {
                                  val qy = cy + (y - cy) * scale + ty
                                  if (qy < 0f || qy > h - 1f) continue
                                  val fy = (y - top).toFloat() / FOCUS_STEP
                                  val upper = (if (a) 1f - fy else 0f) + (if (c) fy else 0f)
                                  val lower = (if (b) 1f - fy else 0f) + (if (d) fy else 0f)
                                  for (x in left until min(left + FOCUS_STEP, w)) {
                                      val qx = cx + (x - cx) * scale + tx
                                      if (qx < 0f || qx > w - 1f) continue
                                      val fx = (x - left).toFloat() / FOCUS_STEP
                                      val weight = if (solid) 1f else upper * (1f - fx) + lower * fx
                                      if (weight <= 0f) continue
                                      val color = sampleRgb(pixels, w, h, qx, qy)
                                      val j = y * w + x
                                      red[j] += weight * ((color ushr 16) and 255)
                                      green[j] += weight * ((color ushr 8) and 255)
                                      blue[j] += weight * (color and 255)
                                      weights[j] += weight
                                  }
                              }
                          }
                      }
                      onProgress("Secilen kareler birlestiriliyor", done + 1, selected.size)
                  }

                  // Use the unwarped reference where a propagated label lies outside its
                  // source image. Reuse the decode buffer for the final ARGB pixels.
                  if (weights.any { it <= 0f }) decode(files[ref], w, h, pixels)
                  parFor(h) { y ->
                      for (x in 0 until w) {
                          val j = y * w + x
                          val weight = weights[j]
                          if (weight <= 0f) continue
                          val r = (red[j] / weight).roundToInt().coerceIn(0, 255)
                          val g = (green[j] / weight).roundToInt().coerceIn(0, 255)
                          val b = (blue[j] / weight).roundToInt().coerceIn(0, 255)
                          pixels[j] = (0xFF shl 24) or (r shl 16) or (g shl 8) or b
                      }
                  }
                  return pixels
              }

              private fun sampleRgb(src: IntArray, w: Int, h: Int, x: Float, y: Float): Int {
                  val x0 = min(x.toInt(), w - 2)
                  val y0 = min(y.toInt(), h - 2)
                  val fx = x - x0
                  val fy = y - y0
                  if (fx == 0f && fy == 0f) return src[y0 * w + x0]
                  val i = y0 * w + x0
                  val a = src[i]
                  val b = src[i + 1]
                  val c = src[i + w]
                  val d = src[i + w + 1]
                  var out = 0xFF shl 24
                  for (shift in 0..16 step 8) {
                      val top = ((a ushr shift) and 255) * (1f - fx) + ((b ushr shift) and 255) * fx
                      val bottom = ((c ushr shift) and 255) * (1f - fx) + ((d ushr shift) and 255) * fx
                      out = out or ((top * (1f - fy) + bottom * fy).roundToInt() shl shift)
                  }
                  return out
              }

              private fun composeTransform(base: DoubleArray, step: DoubleArray): DoubleArray {
                  val s = step[0] * base[0]
                  val tx = step[0] * base[1] + step[1]
                  val ty = step[0] * base[2] + step[2]
                  return doubleArrayOf(s, tx, ty)
              }

              private fun decode(file: File, outW: Int, outH: Int, px: IntArray) {
                  val bo = BitmapFactory.Options().apply { inJustDecodeBounds = true }
                  BitmapFactory.decodeFile(file.path, bo)
                  var sample = 1
                  while (bo.outWidth / (sample * 2) >= outW && bo.outHeight / (sample * 2) >= outH) sample *= 2
                  val o = BitmapFactory.Options().apply {
                      inSampleSize = sample
                      inPreferredConfig = Bitmap.Config.ARGB_8888
                  }
                  val bm = BitmapFactory.decodeFile(file.path, o)
                      ?: throw IllegalStateException("JPEG cozulemedi: ${file.name}")
                  try {
                      val scaled = if (bm.width == outW && bm.height == outH) bm
                          else Bitmap.createScaledBitmap(bm, outW, outH, true)
                      try { scaled.getPixels(px, 0, outW, 0, 0, outW, outH) }
                      finally { if (scaled !== bm) scaled.recycle() }
                  } finally { bm.recycle() }
              }

              private fun convSep(src: FloatArray, w: Int, h: Int, k: FloatArray): FloatArray {
                  val r = k.size / 2
                  val tmp = FloatArray(w * h)
                  val out = FloatArray(w * h)
                  parFor(h) { y ->
                      val o = y * w
                      for (x in 0 until w) {
                          var s = 0f
                          for (i in -r..r) {
                              val xx = min(max(x + i, 0), w - 1)
                              s += k[i + r] * src[o + xx]
                          }
                          tmp[o + x] = s
                      }
                  }
                  parFor(h) { y ->
                      for (x in 0 until w) {
                          var s = 0f
                          for (i in -r..r) {
                              val yy = min(max(y + i, 0), h - 1)
                              s += k[i + r] * tmp[yy * w + x]
                          }
                          out[y * w + x] = s
                      }
                  }
                  return out
              }

              private fun reduce(img: Img): Img {
                  val w = img.w
                  val h = img.h
                  val src = img.d
                  val tmp = FloatArray(w * h)
                  parFor(h) { y ->
                      val o = y * w
                      for (x in 0 until w) {
                          val a = src[o + max(x - 2, 0)]
                          val b = src[o + max(x - 1, 0)]
                          val c = src[o + x]
                          val d = src[o + min(x + 1, w - 1)]
                          val e = src[o + min(x + 2, w - 1)]
                          tmp[o + x] = (a + 4f * b + 6f * c + 4f * d + e) / 16f
                      }
                  }
                  val nw = (w + 1) / 2
                  val nh = (h + 1) / 2
                  val out = FloatArray(nw * nh)
                  parFor(nh) { j ->
                      val y = j * 2
                      val y0 = max(y - 2, 0) * w
                      val y1 = max(y - 1, 0) * w
                      val y2 = y * w
                      val y3 = min(y + 1, h - 1) * w
                      val y4 = min(y + 2, h - 1) * w
                      for (i in 0 until nw) {
                          val x = i * 2
                          out[j * nw + i] =
                              (tmp[y0 + x] + 4f * tmp[y1 + x] + 6f * tmp[y2 + x] + 4f * tmp[y3 + x] + tmp[y4 + x]) / 16f
                      }
                  }
                  return Img(nw, nh, out)
              }

              private fun buildEstPyr(luma: FloatArray, W: Int, H: Int): EstPyr {
                  var cur = Img(W, H, convSep(luma, W, H, GAUSS5))
                  val levels = ArrayList<Img>()
                  levels.add(cur)
                  while (max(cur.w, cur.h) > 120) {
                      cur = reduce(cur)
                      levels.add(Img(cur.w, cur.h, convSep(cur.d, cur.w, cur.h, GAUSS5)))
                  }
                  return EstPyr(levels)
              }

              private fun bilin(a: FloatArray, i0: Int, w: Int, fx: Float, fy: Float): Float =
                  (a[i0] * (1 - fx) + a[i0 + 1] * fx) * (1 - fy) +
                          (a[i0 + w] * (1 - fx) + a[i0 + w + 1] * fx) * fy

              private fun solve3(h: DoubleArray, b: DoubleArray): DoubleArray? {
                  val a = arrayOf(
                      doubleArrayOf(h[0], h[1], h[2], b[0]),
                      doubleArrayOf(h[1], h[3], h[4], b[1]),
                      doubleArrayOf(h[2], h[4], h[5], b[2])
                  )
                  for (i in 0 until 3) {
                      var p = i
                      for (r in i + 1 until 3) if (abs(a[r][i]) > abs(a[p][i])) p = r
                      if (abs(a[p][i]) < 1e-9) return null
                      val t = a[i]; a[i] = a[p]; a[p] = t
                      for (r in i + 1 until 3) {
                          val f = a[r][i] / a[i][i]
                          for (c in i until 4) a[r][c] -= f * a[i][c]
                      }
                  }
                  val x = DoubleArray(3)
                  for (i in 2 downTo 0) {
                      var s = a[i][3]
                      for (c in i + 1 until 3) s -= a[i][c] * x[c]
                      x[i] = s / a[i][i]
                  }
                  return x
              }

              private fun estimate(ref: EstPyr, frm: EstPyr, W: Int, H: Int): DoubleArray {
                  var s = 1.0
                  var tx = 0.0
                  var ty = 0.0
                  val n = min(ref.levels.size, frm.levels.size)
                  for (j in n - 1 downTo 0) {
                      if (j < n - 1) { tx *= 2.0; ty *= 2.0 }
                      val f = (1 shl j).toDouble()
                      val cx = (W - 1) / (2.0 * f)
                      val cy = (H - 1) / (2.0 * f)
                      val R = ref.levels[j]
                      val F = frm.levels[j]
                      val w = R.w
                      val h = R.h
                      val gx = FloatArray(w * h)
                      val gy = FloatArray(w * h)
                      for (y in 1 until h - 1) {
                          for (x in 1 until w - 1) {
                              val i = y * w + x
                              gx[i] = (F.d[i + 1] - F.d[i - 1]) * 0.5f
                              gy[i] = (F.d[i + w] - F.d[i - w]) * 0.5f
                          }
                      }
                      val iters = if (j == 0) 10 else 16
                      val st = if (w * h > 450_000) 2 else 1
                      for (iter in 0 until iters) {
                          val hh = DoubleArray(6)
                          val bb = DoubleArray(3)
                          var cnt = 0
                          for (y in 2 until h - 2 step st) {
                              val uy = y - cy
                              for (x in 2 until w - 2 step st) {
                                  val ux = x - cx
                                  val qx = cx + s * ux + tx
                                  val qy = cy + s * uy + ty
                                  if (qx < 2.0 || qy < 2.0 || qx > w - 3.0 || qy > h - 3.0) continue
                                  val x0 = qx.toInt()
                                  val y0 = qy.toInt()
                                  val fx = (qx - x0).toFloat()
                                  val fy = (qy - y0).toFloat()
                                  val i0 = y0 * w + x0
                                  val fv = bilin(F.d, i0, w, fx, fy)
                                  val gxv = bilin(gx, i0, w, fx, fy).toDouble()
                                  val gyv = bilin(gy, i0, w, fx, fy).toDouble()
                                  val r = (fv - R.d[y * w + x]).toDouble()
                                  val j0 = gxv * ux + gyv * uy
                                  val weight = 16.0 / max(16.0, abs(r))
                                  hh[0] += weight * j0 * j0; hh[1] += weight * j0 * gxv; hh[2] += weight * j0 * gyv
                                  hh[3] += weight * gxv * gxv; hh[4] += weight * gxv * gyv; hh[5] += weight * gyv * gyv
                                  bb[0] -= weight * j0 * r; bb[1] -= weight * gxv * r; bb[2] -= weight * gyv * r
                                  cnt++
                              }
                          }
                          if (cnt < 200) break
                          hh[0] *= 1.0005; hh[3] *= 1.0005; hh[5] *= 1.0005
                          val d = solve3(hh, bb) ?: break
                          s += d[0]; tx += d[1]; ty += d[2]
                          s = s.coerceIn(0.82, 1.22)
                          tx = tx.coerceIn(-0.20 * w, 0.20 * w)
                          ty = ty.coerceIn(-0.20 * h, 0.20 * h)
                          if (abs(d[0]) < 2e-6 && abs(d[1]) < 2e-3 && abs(d[2]) < 2e-3) break
                      }
                  }
                  return doubleArrayOf(s, tx, ty)
              }
          }
          EOF

          cat > app/src/main/java/com/s23ultra/focusstack/MainActivity.kt << 'EOF'
          package com.s23ultra.focusstack

          import android.Manifest
          import android.annotation.SuppressLint
          import android.app.Activity
          import android.content.ContentValues
          import android.content.pm.PackageManager
          import android.graphics.Bitmap
